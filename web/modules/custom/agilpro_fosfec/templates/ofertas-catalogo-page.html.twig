{#
/**
 * @file
 * Template para el catálogo de convocatorias y ofertas FOSFEC (/ofertas).
 */
#}
<div class="ofertas-catalogo-wrapper" style="margin-top:1.5rem; margin-bottom:4rem; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size:1.05rem;">

  {# Banner Cabecera #}
  <div style="background: linear-gradient(135deg, #002d62 0%, #0052cc 100%) !important; color:#ffffff !important; padding:2.5rem 2rem; border-radius:18px; box-shadow:0 12px 30px rgba(0,45,98,0.18); margin-bottom:2.5rem; text-align:center;">
    <span style="background:rgba(255,255,255,0.22); color:#ffffff !important; padding:5px 14px; border-radius:20px; font-size:0.9rem; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; display:inline-block; margin-bottom:0.75rem;">
      Compensar FOSFEC
    </span>
    <h1 style="font-size:2.4rem; font-weight:800; margin:0 0 0.75rem; letter-spacing:-0.02em; color:#ffffff !important;">
      🚀 Convocatorias de Fomento y Fortalecimiento Empresarial
    </h1>
    <p style="font-size:1.15rem; max-width:800px; margin:0 auto; color:#f8fafc !important; line-height:1.6;">
      Acceda a programas especializados de acompañamiento técnico, mentorías estratégicas y recursos de fomento para acelerar el crecimiento de su organización.
    </p>
  </div>

  {# Grid de Convocatorias #}
  {% if ofertas|length == 0 %}
    <div style="background:#fff; border:1px solid #e2e8f0; border-radius:16px; padding:3rem; text-align:center; color:#64748b;">
      <h3 style="color:#0f172a; font-weight:700; margin-bottom:0.5rem;">No hay convocatorias abiertas en este momento</h3>
      <p style="font-size:1.1rem;">Próximamente publicaremos nuevas oportunidades de financiamiento y aceleración.</p>
    </div>
  {% else %}
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(350px, 1fr)); gap:1.75rem;">
      {% for of in ofertas %}
        <div style="background:#fff; border:1px solid #e2e8f0; border-radius:18px; overflow:hidden; box-shadow:0 6px 20px rgba(15,23,42,0.06); display:flex; flex-direction:column; transition:transform 0.2s, box-shadow 0.2s;">
          
          {# Imagen o Header visual #}
          <div style="height:190px; background:#f1f5f9; position:relative; overflow:hidden;">
            {% if of.image_url %}
              <img src="{{ of.image_url }}" alt="{{ of.title }}" style="width:100%; height:100%; object-fit:cover;">
            {% else %}
              <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%); color:#64748b; font-size:3rem;">
                🏢
              </div>
            {% endif %}

            {# Badge de estado #}
            <div style="position:absolute; top:14px; right:14px;">
              {% if of.is_open %}
                <span style="background:#10b981; color:#fff; font-size:0.85rem; font-weight:700; padding:5px 12px; border-radius:20px; box-shadow:0 2px 8px rgba(16,185,129,0.4);">
                  ● Convocatoria Abierta
                </span>
              {% else %}
                <span style="background:#64748b; color:#fff; font-size:0.85rem; font-weight:700; padding:5px 12px; border-radius:20px;">
                  Convocatoria Cerrada
                </span>
              {% endif %}
            </div>
          </div>

          {# Cuerpo de la tarjeta #}
          <div style="padding:1.6rem; display:flex; flex-direction:column; flex-grow:1;">
            {% if of.eje %}
              <span style="font-size:0.82rem; font-weight:700; color:#e0592a; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:0.35rem;">
                {{ of.eje }}
              </span>
            {% endif %}

            <h3 style="font-size:1.35rem; font-weight:800; color:#0f172a; margin:0 0 0.75rem; line-height:1.35;">
              <a href="{{ of.url }}" style="color:#0f172a; text-decoration:none;">{{ of.title }}</a>
            </h3>

            <p style="color:#475569; font-size:0.98rem; line-height:1.55; margin-bottom:1.25rem; flex-grow:1;">
              {{ of.summary }}
            </p>

            {# Metadatos de la Oferta #}
            <div style="background:#f8fafc; border:1px solid #edf2f7; border-radius:12px; padding:12px 14px; margin-bottom:1.4rem; font-size:0.92rem;">
              <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
                <span style="color:#64748b;">📅 <strong>Inscripciones:</strong></span>
                <span style="font-weight:600; color:#1e293b;">{{ of.fechas }}</span>
              </div>
              <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
                <span style="color:#64748b;">👥 <strong>Modalidad:</strong></span>
                <span style="font-weight:600; color:#1e293b;">{{ of.modalidad }}</span>
              </div>
              <div style="display:flex; justify-content:space-between;">
                <span style="color:#64748b;">🎟️ <strong>Cupos disponibles:</strong></span>
                <span style="font-weight:700; color:#0052cc;">{{ of.cupos_disponibles }} de {{ of.cupos_totales }}</span>
              </div>
            </div>

            {# Botón de Acción #}
            <div style="margin-top:auto;">
              <a href="{{ of.url }}" class="btn-corp btn-corp-orange" style="width:100%; justify-content:center; padding:0.75rem 1.25rem; font-size:1.02rem;">
                Ver Detalles y Postularme ➔
              </a>
            </div>

          </div>

        </div>
      {% endfor %}
    </div>
  {% endif %}

</div>
