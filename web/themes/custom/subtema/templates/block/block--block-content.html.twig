{% set d7_block_id = attributes.id|replace({'block-subtema-block-': 'block-block-'}) %}
<section{{ attributes.setAttribute('id', d7_block_id).addClass('block', 'block-block', 'clearfix')|without('data-component-id') }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes.addClass('block-title') }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}
    {{ content }}
  {% endblock %}
</section>